# ---------------------------------------------------------------------------
# CodePilot AI — example environment. Copy to .env and fill in what you use.
# Never commit real credentials. Placeholder names only.
# ---------------------------------------------------------------------------

# Public origin of this instance (used for OAuth callbacks and links).
APP_URL=http://localhost:3000

# REQUIRED in production. 48+ random bytes, e.g. `openssl rand -base64 48`.
# Protects session token hashes and encrypts provider keys / GitHub tokens.
APP_SECRET=

# SQLite database file. Defaults to ./data/codepilot.db
DATABASE_PATH=./data/codepilot.db

# Root for the database, workspaces and baselines.
CODEPILOT_DATA_DIR=./data

# ---------------------------------------------------------------------------
# GitHub — optional. Set both client values for OAuth App mode; add the App
# values for GitHub App mode (recommended, installation-scoped tokens).
# Callback URL: ${APP_URL}/api/github/callback
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Research — optional. SearXNG is the recommended free/self-hosted option.
# ---------------------------------------------------------------------------
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
RESEARCH_DISABLE_DUCKDUCKGO=

# ---------------------------------------------------------------------------
# Execution — opt-in local runner. Only enable on a host you control.
# ---------------------------------------------------------------------------
EXECUTION_ENABLED=0
EXECUTION_ALLOW_NETWORK=0
EXECUTION_TIMEOUT_MS=120000
EXECUTION_MAX_OUTPUT_BYTES=200000

# ---------------------------------------------------------------------------
# Provider network policy
# ---------------------------------------------------------------------------
# Extra hostnames treated as local runtimes (comma separated).
ALLOW_LOCAL_PROVIDER_HOSTS=
# DANGEROUS: allow arbitrary private provider URLs. Keep 0 unless every user is trusted.
ALLOW_PRIVATE_CUSTOM_ENDPOINTS=0

# Optional hints for a local OpenCode runtime (configure in the UI as well).
OPENCODE_SERVER_URL=
OPENCODE_SERVER_PASSWORD=

# Set to 1 only after every legal placeholder is completed and reviewed.
LEGAL_PLACEHOLDERS_RESOLVED=0
